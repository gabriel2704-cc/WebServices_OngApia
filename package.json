{
  "name": "ong-apia-server",
  "version": "1.0.0",
  "description": "API em Node.js com Drizzle ORM e PostgreSQL para a ONG APIA",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch index.js",
    "start": "node index.js",
    "build": "echo \"Backend em JS puro (sem necessidade de build)\"",
    "test": "node --test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node database/seed.js"
  },
  "keywords": ["ong", "apia", "drizzle", "express", "postgresql"],
  "author": "Daniel Cipriano da Silva e Gabriel de Oliveira - IFSUL",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.3",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "drizzle-kit": "^0.30.1"
  }
}
