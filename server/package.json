{
  "name": "ong-apia-server",
  "version": "1.0.0",
  "description": "Backend API para ONG APIA - Associação de Protetores Incondicionais dos Animais",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
